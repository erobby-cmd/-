# Claude, picks the words
ANTHROPIC_API_KEY=

# X API (read). Bearer token from developer.x.com
X_BEARER_TOKEN=
TARGET_USER_ID=44196397
POLL_SECONDS=60

# Filtering
MIN_IMPORTANCE=7
MAX_COINS_PER_POST=3

# Solana / pump.fun. Leave DRY_RUN=true until you trust it.
DRY_RUN=true
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
WALLET_PRIVATE_KEY=
# Percent of each coin you keep (bought at launch). 10% ≈ 3.1 SOL per coin
DEV_BUY_PERCENT=10
SLIPPAGE=10
PRIORITY_FEE=0.0005
MAX_SOL_PER_DAY=10

# Optional: announce from YOUR OWN X account
ANNOUNCE_ON_X=false
X_APP_KEY=
X_APP_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
